<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/moments_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/chat_canvas"
    android:orientation="vertical">
    <LinearLayout
        android:id="@+id/moments_toolbar"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:background="@color/chat_canvas"
        android:paddingHorizontal="12dp"
        android:gravity="center_vertical">
        <ImageButton
            android:id="@+id/moments_back"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/moments_back"
            android:padding="12dp"
            android:src="@drawable/ic_chat_back"
            android:tint="@color/utechat_primary" />
        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1">
            <TextView
                android:id="@+id/moments_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:accessibilityHeading="true"
                android:ellipsize="end"
                android:gravity="center"
                android:maxLines="1"
                android:minHeight="44dp"
                android:paddingHorizontal="16dp"
                android:text="@string/moments_title"
                android:textColor="@color/utechat_on_surface"
                android:textSize="16sp"
                android:textStyle="bold" />
        </FrameLayout>
        <ImageButton
            android:id="@+id/moments_action"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:padding="12dp"
            android:tint="@color/utechat_primary" />
    </LinearLayout>
    <ScrollView
        android:id="@+id/moments_scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true">
        <LinearLayout
            android:id="@+id/moments_body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp" />
    </ScrollView>
    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/moments_pager"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:visibility="gone" />

    <TextView
        android:id="@+id/moments_stream_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:accessibilityLiveRegion="polite"
        android:gravity="center"
        android:padding="8dp"
        android:textColor="@color/utechat_on_surface_variant"
        android:visibility="gone" />
</LinearLayout>
