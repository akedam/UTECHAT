<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/utechat_background">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_horizontal" android:orientation="vertical" android:padding="@dimen/space_lg">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/profile_title" android:textColor="@color/utechat_primary" android:textSize="@dimen/text_xxl" android:textStyle="bold" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_lg" android:background="@drawable/bg_list_item" android:gravity="center_horizontal" android:orientation="vertical" android:padding="@dimen/space_lg">
        <ImageView android:id="@+id/iv_avatar" android:layout_width="@dimen/avatar_size_xl" android:layout_height="@dimen/avatar_size_xl" android:background="@drawable/bg_avatar_circle_primary" android:contentDescription="@string/cd_avatar" android:src="@drawable/bg_avatar_circle_primary" />
        <TextView android:id="@+id/tv_name" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_md" android:gravity="center" android:textColor="@color/utechat_on_surface" android:textSize="@dimen/text_xl" android:textStyle="bold" />
        <TextView android:id="@+id/tv_email" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:textColor="@color/utechat_on_surface_variant" android:textSize="@dimen/text_md" />
        <TextView android:id="@+id/tv_bio" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_md" android:gravity="center" android:textColor="@color/utechat_on_surface" android:textSize="@dimen/text_md" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_md" android:gravity="center" android:text="@string/profile_avatar_unavailable" android:textColor="@color/utechat_on_surface_variant" android:textSize="@dimen/text_sm" />
        <com.google.android.material.button.MaterialButton android:id="@+id/btn_edit_profile" android:layout_width="match_parent" android:layout_height="@dimen/touch_target_min" android:layout_marginTop="@dimen/space_lg" android:text="@string/btn_edit_profile" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_md" android:background="@drawable/bg_list_item" android:orientation="vertical" android:padding="@dimen/space_md">
        <com.google.android.material.switchmaterial.SwitchMaterial android:id="@+id/switch_share_presence" android:layout_width="match_parent" android:layout_height="@dimen/touch_target_min" android:layout_marginTop="@dimen/space_md" android:text="@string/presence_setting" android:textColor="@color/utechat_on_surface" />
        <TextView android:id="@+id/tv_presence_summary" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/presence_summary" android:textColor="@color/utechat_on_surface_variant" android:textSize="@dimen/text_sm" android:paddingStart="@dimen/space_md" android:paddingEnd="@dimen/space_md" />
        <com.google.android.material.switchmaterial.SwitchMaterial android:id="@+id/switch_message_previews" android:layout_width="match_parent" android:layout_height="@dimen/touch_target_min" android:layout_marginTop="@dimen/space_sm" android:text="@string/notifications_preview_setting" android:textColor="@color/utechat_on_surface" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/notifications_preview_summary" android:textColor="@color/utechat_on_surface_variant" android:textSize="@dimen/text_sm" android:paddingStart="@dimen/space_md" android:paddingEnd="@dimen/space_md" />
        <com.google.android.material.button.MaterialButton android:id="@+id/btn_logout" style="@style/Widget.Material3.Button.OutlinedButton" android:layout_width="match_parent" android:layout_height="@dimen/touch_target_min" android:layout_marginTop="@dimen/space_sm" android:text="@string/btn_logout" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
