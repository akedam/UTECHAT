<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/list_item_gap" android:layout_marginBottom="@dimen/list_item_gap" android:minHeight="72dp" android:gravity="center_vertical" android:orientation="horizontal" android:paddingHorizontal="@dimen/list_item_padding_h" android:paddingVertical="@dimen/list_item_padding_v" android:background="@drawable/bg_list_item" android:clickable="true" android:focusable="true" android:foreground="?attr/selectableItemBackground">
    <FrameLayout android:layout_width="@dimen/avatar_size_md" android:layout_height="@dimen/avatar_size_md">
        <TextView android:id="@+id/tv_avatar_placeholder" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/bg_avatar_circle_accent" android:gravity="center" android:textColor="@color/white" android:textSize="@dimen/text_md" android:textStyle="bold" android:importantForAccessibility="no" />
        <View android:id="@+id/view_online_indicator" android:layout_width="@dimen/online_indicator_size" android:layout_height="@dimen/online_indicator_size" android:layout_gravity="bottom|end" android:background="@drawable/bg_online_indicator" android:contentDescription="@string/cd_online_indicator" />
    </FrameLayout>
    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="@dimen/space_md" android:orientation="vertical">
        <TextView android:id="@+id/tv_friend_name" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/utechat_on_surface" android:textSize="@dimen/text_md" android:textStyle="bold" />
        <TextView android:id="@+id/tv_friend_status" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_xs" android:textColor="@color/utechat_on_surface_variant" android:textSize="@dimen/text_sm" />
    </LinearLayout>
</LinearLayout>
