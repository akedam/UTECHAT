<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:orientation="vertical"
    android:id="@+id/chat_root">
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="62dp"
        android:background="@color/white"
        app:navigationContentDescription="@string/cd_back"
        app:navigationIconTint="@color/chat_text"
        app:contentInsetStartWithNavigation="0dp">
        <LinearLayout
            android:id="@+id/chat_identity"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginEnd="4dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <FrameLayout
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:layout_marginEnd="8dp"
                android:importantForAccessibility="noHideDescendants">
                <TextView
                    android:id="@+id/chat_avatar_initial"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_chat_header_avatar"
                    android:gravity="center"
                    android:textColor="@color/chat_accent"
                    android:textSize="14sp"
                    android:textStyle="bold" />
                <ImageView
                    android:id="@+id/chat_avatar_photo"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />
                <View
                    android:id="@+id/chat_online_badge"
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:layout_gravity="bottom|end"
                    android:background="@drawable/bg_chat_online_badge"
                    android:visibility="gone" />
            </FrameLayout>
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">
                <TextView
                    android:id="@+id/chat_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textAppearance="@style/ChatToolbarTitle" />
                <TextView
                    android:id="@+id/chat_subtitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/chat_meta"
                    android:textSize="12sp"
                    android:visibility="gone" />
            </LinearLayout>
        </LinearLayout>
    </com.google.android.material.appbar.MaterialToolbar>
    <TextView
        android:id="@+id/chat_connection_banner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:accessibilityLiveRegion="polite"
        android:background="@color/utechat_surface_variant"
        android:paddingHorizontal="@dimen/list_item_padding_h"
        android:paddingVertical="@dimen/space_sm"
        android:text="@string/chat_no_connection"
        android:textColor="@color/utechat_on_surface"
        android:visibility="gone" />
    <TextView
        android:id="@+id/tv_chat_source"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/utechat_surface_variant"
        android:paddingHorizontal="@dimen/list_item_padding_h"
        android:paddingVertical="@dimen/space_sm"
        android:text="@string/mock_message_notice"
        android:textColor="@color/utechat_on_surface"
        android:textSize="@dimen/text_sm"
        android:visibility="gone" />
    <LinearLayout
        android:id="@+id/tv_chat_send_error"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/utechat_surface"
        android:elevation="4dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/list_item_padding_h"
        android:paddingEnd="@dimen/space_xs"
        android:visibility="gone">
        <TextView
            android:id="@+id/tv_chat_send_error_message"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:paddingVertical="@dimen/space_xs"
            android:textColor="@color/utechat_error"
            android:textSize="@dimen/text_sm" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_retry_stream"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/touch_target_min"
            android:minWidth="@dimen/touch_target_min"
            android:text="@string/btn_retry"
            android:textSize="@dimen/text_xs" />
    </LinearLayout>
    <TextView
        android:id="@+id/tv_pinned_message"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="48dp"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp"
        android:singleLine="true"
        android:ellipsize="end"
        android:textColor="@color/utechat_primary"
        android:background="@color/utechat_surface"
        android:foreground="?attr/selectableItemBackground"
        android:visibility="gone" />
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@color/chat_conversation_canvas">
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_messages"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingTop="@dimen/space_sm"
            android:paddingBottom="@dimen/space_sm"
            android:scrollbars="vertical"
            android:visibility="gone" />
        <FrameLayout
            android:id="@+id/progress_chat"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom"
                android:importantForAccessibility="noHideDescendants"
                android:orientation="vertical"
                android:padding="16dp">
                <View android:layout_width="172dp" android:layout_height="44dp" android:background="@drawable/bg_chat_skeleton" />
                <View android:layout_width="136dp" android:layout_height="46dp" android:layout_gravity="end"
                    android:layout_marginTop="10dp" android:background="@drawable/bg_chat_skeleton" />
                <View android:layout_width="196dp" android:layout_height="54dp" android:layout_marginTop="10dp"
                    android:background="@drawable/bg_chat_skeleton" />
            </LinearLayout>
            <ProgressBar
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_gravity="center"
                android:contentDescription="@string/chat_loading"
                android:indeterminateTint="@color/chat_accent" />
        </FrameLayout>
        <LinearLayout
            android:id="@+id/chat_error_state"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="@dimen/space_xl"
            android:visibility="gone">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/chat_error_title"
                android:textColor="@color/utechat_on_surface"
                android:textSize="@dimen/text_lg"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/tv_chat_error"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_sm"
                android:gravity="center"
                android:text="@string/chat_load_error"
                android:textColor="@color/utechat_on_surface_variant"
                android:textSize="@dimen/text_md" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_retry_chat"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/touch_target_min"
                android:layout_marginTop="@dimen/space_md"
                android:text="@string/btn_retry" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/empty_chat_state"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="@dimen/space_xl"
            android:visibility="gone">
            <ImageView
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:layout_marginBottom="14dp"
                android:background="@drawable/bg_chat_header_avatar"
                android:importantForAccessibility="no"
                android:padding="17dp"
                android:src="@drawable/ic_nav_messages"
                app:tint="@color/chat_accent" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/empty_chat_title"
                android:textColor="@color/utechat_on_surface"
                android:textSize="@dimen/text_lg"
                android:textStyle="bold" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_sm"
                android:gravity="center"
                android:text="@string/empty_chat_message"
                android:textColor="@color/chat_meta"
                android:textSize="@dimen/text_md" />
        </LinearLayout>
        <ProgressBar
            android:id="@+id/progress_history" style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="top"
            android:indeterminate="true"
            android:visibility="gone" />
    </FrameLayout>
    <TextView
        android:id="@+id/tv_blocked_chat"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/utechat_surface"
        android:padding="16dp"
        android:text="@string/blocked_chat_notice"
        android:textColor="@color/utechat_on_surface"
        android:visibility="gone" />
    <LinearLayout
        android:id="@+id/reply_composer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/utechat_surface"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:visibility="gone">
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingVertical="6dp">
            <TextView
                android:id="@+id/tv_reply_target"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/utechat_primary"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/tv_reply_preview"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/utechat_on_surface_variant" />
        </LinearLayout>
        <ImageButton
            android:id="@+id/btn_clear_reply"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/message_reply_cancel"
            android:src="@android:drawable/ic_menu_close_clear_cancel"
            android:tint="@color/utechat_on_surface_variant" />
    </LinearLayout>
    <LinearLayout
        android:id="@+id/chat_composer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/utechat_surface"
        android:gravity="bottom"
        android:orientation="horizontal"
        android:elevation="2dp"
        android:paddingHorizontal="8dp"
        android:paddingVertical="8dp">
        <ImageButton
            android:id="@+id/btn_chat_emoji"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@drawable/ic_chat_smile"
            android:padding="12dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/chat_emoji"
            android:tint="@color/chat_meta" />
        <EditText
            android:id="@+id/et_message"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/bg_chat_composer_input"
            android:hint="@string/hint_message"
            android:imeOptions="actionSend"
            android:inputType="textCapSentences|textMultiLine"
            android:maxLines="4"
            android:minHeight="@dimen/touch_target_min"
            android:paddingHorizontal="11dp"
            android:paddingVertical="@dimen/space_sm"
            android:textColor="@color/chat_text"
            android:textColorHint="@color/chat_meta"
            android:textSize="16sp" />
        <ImageButton
            android:id="@+id/btn_chat_more"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@drawable/ic_chat_more"
            android:padding="12dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/chat_more"
            android:tint="@color/chat_meta" />
        <ImageButton
            android:id="@+id/btn_attach_image"
            android:layout_width="@dimen/touch_target_min"
            android:layout_height="@dimen/touch_target_min"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/cd_attach_image"
            android:src="@drawable/ic_chat_gallery"
            android:tint="@color/chat_meta" />
        <ImageButton
            android:id="@+id/btn_send"
            android:layout_width="@dimen/touch_target_min"
            android:layout_height="@dimen/touch_target_min"
            android:layout_marginStart="@dimen/space_xs"
            android:background="@drawable/bg_chat_send"
            android:contentDescription="@string/cd_send_message"
            android:enabled="false"
            android:src="@drawable/ic_chat_send"
            android:tint="@color/chat_send_icon" />
    </LinearLayout>
</LinearLayout>
