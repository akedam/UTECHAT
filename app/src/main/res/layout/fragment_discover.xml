<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical"
    android:background="@color/utechat_background">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:gravity="center_vertical" android:padding="16dp" android:background="@drawable/bg_header_gradient">
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/discover_title"
                android:textColor="@color/white" android:textSize="24sp" android:textStyle="bold" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp"
                android:text="@string/community_subtitle" android:textColor="#F0F8FF" android:textSize="13sp" />
        </LinearLayout>
        <ImageButton android:id="@+id/btn_community_search" android:layout_width="48dp" android:layout_height="48dp"
            android:src="@drawable/ic_search_outline" android:padding="12dp" android:tint="@color/white"
            android:background="?attr/selectableItemBackgroundBorderless" android:contentDescription="@string/ui_search" />
    </LinearLayout>
    <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:fillViewport="true" android:clipToPadding="false">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"
            android:paddingHorizontal="16dp" android:paddingTop="16dp" android:paddingBottom="24dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"
                android:padding="16dp" android:background="@drawable/bg_community_card">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/community_create_title"
                    android:textColor="@color/utechat_on_surface" android:textSize="18sp" android:textStyle="bold" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp"
                    android:text="@string/community_create_hint" android:textColor="@color/community_muted" android:textSize="14sp" />
                <com.google.android.material.textfield.TextInputLayout android:id="@+id/layout_group_name" style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:hint="@string/groups_name_hint"
                    app:boxCornerRadiusTopStart="12dp" app:boxCornerRadiusTopEnd="12dp" app:boxCornerRadiusBottomStart="12dp" app:boxCornerRadiusBottomEnd="12dp"
                    app:boxStrokeColor="@color/community_action" app:hintTextColor="@color/community_action">
                    <com.google.android.material.textfield.TextInputEditText android:id="@+id/et_group_name"
                        android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="56dp"
                        android:inputType="textCapSentences" android:maxLength="80" android:singleLine="true"
                        android:textSize="16sp" android:textColor="@color/utechat_on_surface" android:imeOptions="actionDone" />
                </com.google.android.material.textfield.TextInputLayout>
                <com.google.android.material.button.MaterialButton android:id="@+id/btn_create_group" style="@style/CommunityPrimaryButton"
                    android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="12dp"
                    android:text="@string/community_choose_members" app:icon="@drawable/ic_add_outline" app:iconGravity="textStart" />
            </LinearLayout>
            <TextView android:id="@+id/tv_groups_error" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="12dp" android:padding="12dp" android:background="@drawable/bg_community_card"
                android:textColor="@color/community_danger" android:textSize="14sp" android:accessibilityLiveRegion="polite" android:visibility="gone" />
            <ProgressBar android:id="@+id/progress_groups" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent"
                android:layout_height="3dp" android:layout_marginTop="12dp" android:indeterminate="true" android:indeterminateTint="@color/community_action"
                android:contentDescription="@string/groups_create_button" android:visibility="gone" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:layout_marginTop="24dp" android:layout_marginBottom="12dp">
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/community_your_groups"
                    android:textSize="18sp" android:textStyle="bold" android:textColor="@color/utechat_on_surface" />
                <TextView android:id="@+id/tv_group_count" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="13sp"
                    android:textColor="@color/community_muted" />
            </LinearLayout>
            <LinearLayout android:id="@+id/tv_group_empty" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:background="@drawable/bg_community_card" android:orientation="vertical" android:gravity="center" android:padding="24dp">
                <ImageView android:layout_width="64dp" android:layout_height="64dp" android:background="@drawable/bg_community_icon"
                    android:src="@drawable/ic_chat_group" android:tint="@color/community_action" android:padding="16dp" android:contentDescription="@null" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp"
                    android:text="@string/community_empty_title" android:gravity="center" android:textColor="@color/utechat_on_surface" android:textStyle="bold" android:textSize="17sp" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp"
                    android:text="@string/community_empty_hint" android:gravity="center" android:textColor="@color/community_muted" android:textSize="14sp" />
            </LinearLayout>
            <LinearLayout android:id="@+id/layout_groups" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
