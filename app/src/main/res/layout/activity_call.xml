<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/call_root"
    android:layout_width="match_parent" android:layout_height="match_parent" android:background="#000000">
    <FrameLayout android:id="@+id/remote_video_container"
        android:layout_width="0dp" android:layout_height="0dp"
        android:contentDescription="@string/call_remote_video_description" android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent" app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent" />
    <LinearLayout android:id="@+id/call_header" android:layout_width="0dp" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="20dp"
        app:layout_constraintTop_toTopOf="parent" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent">
        <TextView android:id="@+id/tv_call_peer" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/call_generic_peer" android:textColor="#FFFFFF" android:textSize="17sp" android:textStyle="bold" android:maxLines="1" android:ellipsize="end" />
        <TextView android:id="@+id/tv_call_title" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="4dp" android:text="@string/call_audio_title" android:textColor="#BFC0C5" android:textSize="12sp" />
        <TextView android:id="@+id/tv_call_header_status" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="4dp" android:textColor="#BFC0C5" android:textSize="12sp" android:visibility="gone" />
    </LinearLayout>
    <LinearLayout android:id="@+id/audio_peer_state" android:layout_width="0dp" android:layout_height="wrap_content"
        android:orientation="vertical" android:gravity="center" android:paddingHorizontal="28dp"
        app:layout_constraintTop_toBottomOf="@id/call_header" app:layout_constraintBottom_toTopOf="@id/call_controls"
        app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintVertical_bias="0.42">
        <ImageView android:id="@+id/iv_call_avatar" android:layout_width="100dp" android:layout_height="100dp"
            android:background="@drawable/bg_call_avatar" android:src="@drawable/ic_nav_profile"
            android:padding="26dp" android:tint="#DDDDDF" android:contentDescription="@string/cd_avatar" />
        <TextView android:id="@+id/tv_audio_peer_name" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="18dp" android:gravity="center" android:text="@string/call_generic_peer"
            android:textColor="#FFFFFF" android:textSize="24sp" android:textStyle="bold" />
        <TextView android:id="@+id/tv_call_status" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="10dp" android:gravity="center" android:accessibilityLiveRegion="polite"
            android:text="@string/call_state_preparing" android:textColor="#BFC0C5" android:textSize="14sp" />
        <ProgressBar android:id="@+id/progress_call" android:layout_width="24dp" android:layout_height="24dp"
            android:layout_marginTop="16dp" android:indeterminateTint="#FFFFFF" android:visibility="gone" android:contentDescription="@string/call_state_connecting" />
        <TextView android:id="@+id/tv_call_error" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="12dp" android:gravity="center" android:textColor="#FFB4AB" android:textSize="13sp" android:visibility="gone" />
    </LinearLayout>
    <FrameLayout android:id="@+id/local_video_container" android:layout_width="112dp" android:layout_height="152dp"
        android:layout_marginEnd="16dp" android:layout_marginBottom="20dp" android:background="@drawable/bg_call_preview"
        android:clipToOutline="true" android:elevation="6dp" android:visibility="gone" android:contentDescription="@string/call_local_video_description"
        app:layout_constraintEnd_toEndOf="parent" app:layout_constraintBottom_toTopOf="@id/call_controls" />
    <LinearLayout android:id="@+id/call_controls" android:layout_width="0dp" android:layout_height="wrap_content"
        android:orientation="vertical" android:gravity="center" android:paddingTop="16dp" android:paddingBottom="28dp" android:paddingHorizontal="12dp"
        app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintBottom_toBottomOf="parent">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:orientation="horizontal">
            <LinearLayout android:id="@+id/in_call_actions" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:gravity="center" android:orientation="horizontal" android:visibility="gone">
                <ImageButton android:id="@+id/btn_toggle_speaker" style="@style/CallControlButton" android:src="@drawable/ic_call_speaker" android:contentDescription="@string/call_speaker_toggle" />
                <ImageButton android:id="@+id/btn_switch_camera" style="@style/CallControlButton" android:src="@drawable/ic_call_switch_camera" android:contentDescription="@string/call_switch_camera" android:visibility="gone" />
                <ImageButton android:id="@+id/btn_toggle_camera" style="@style/CallControlButton" android:src="@drawable/ic_video_outline" android:contentDescription="@string/call_camera_toggle" android:visibility="gone" />
                <ImageButton android:id="@+id/btn_toggle_mic" style="@style/CallControlButton" android:src="@drawable/ic_call_mic" android:contentDescription="@string/call_mic_toggle" />
            </LinearLayout>
            <ImageButton android:id="@+id/btn_end_call" style="@style/CallControlButton" android:background="@drawable/bg_call_end"
                android:src="@drawable/ic_call_hangup" android:tint="#FFFFFF" android:contentDescription="@string/call_end" android:visibility="gone" />
        </LinearLayout>
        <LinearLayout android:id="@+id/incoming_actions" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:gravity="center" android:orientation="horizontal" android:visibility="gone" android:layout_marginTop="16dp">
            <com.google.android.material.button.MaterialButton android:id="@+id/btn_reject_call" android:layout_width="0dp" android:layout_height="56dp"
                android:layout_weight="1" android:layout_marginEnd="8dp" android:text="@string/call_reject" android:textColor="#FFFFFF" app:backgroundTint="#E52737" app:cornerRadius="28dp" />
            <com.google.android.material.button.MaterialButton android:id="@+id/btn_accept_call" android:layout_width="0dp" android:layout_height="56dp"
                android:layout_weight="1" android:layout_marginStart="8dp" android:text="@string/call_accept" android:textColor="#FFFFFF" app:backgroundTint="#24A861" app:cornerRadius="28dp" />
        </LinearLayout>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
