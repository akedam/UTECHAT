<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/utechat_background"
    android:orientation="vertical">

    <!-- Fragment container: takes up all space above BottomNav -->
    <FrameLayout
        android:id="@+id/fragment_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/utechat_divider" />
    <!-- Bottom Navigation -->
    <LinearLayout
        android:id="@+id/bottom_nav"
        android:layout_width="match_parent"
        android:layout_height="@dimen/bottom_nav_height"
        android:layout_gravity="bottom"
        android:background="@color/utechat_surface"
        android:elevation="0dp"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/nav_conversations"
            style="@style/BottomNavigationItem"
            android:contentDescription="@string/nav_conversations">
            <ImageView
                style="@style/BottomNavigationIcon"
                android:src="@drawable/ic_nav_messages" />
            <TextView
                style="@style/BottomNavigationLabel"
                android:text="@string/nav_conversations" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/nav_friends"
            style="@style/BottomNavigationItem"
            android:contentDescription="@string/nav_friends">
            <ImageView
                style="@style/BottomNavigationIcon"
                android:src="@drawable/ic_nav_friends" />
            <TextView
                style="@style/BottomNavigationLabel"
                android:text="@string/nav_friends" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/nav_discover"
            style="@style/BottomNavigationItem"
            android:contentDescription="@string/nav_discover">
            <ImageView
                style="@style/BottomNavigationIcon"
                android:src="@drawable/ic_nav_discover" />
            <TextView
                style="@style/BottomNavigationLabel"
                android:text="@string/nav_discover" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/nav_profile"
            style="@style/BottomNavigationItem"
            android:contentDescription="@string/nav_profile">
            <ImageView
                style="@style/BottomNavigationIcon"
                android:src="@drawable/ic_nav_profile" />
            <TextView
                style="@style/BottomNavigationLabel"
                android:text="@string/nav_profile" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
