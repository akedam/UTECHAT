<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- Base application theme for UTEChat -->
    <style name="Base.Theme.UTEChat" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Brand primary -->
        <item name="colorPrimary">@color/utechat_primary</item>
        <item name="colorPrimaryDark">@color/utechat_primary_dark</item>
        <item name="colorPrimaryVariant">@color/utechat_primary_dark</item>
        <item name="colorOnPrimary">@color/utechat_on_primary</item>

        <!-- Brand secondary / accent -->
        <item name="colorSecondary">@color/utechat_secondary</item>
        <item name="colorOnSecondary">@color/utechat_on_secondary</item>

        <!-- Surface & background -->
        <item name="android:colorBackground">@color/utechat_background</item>
        <item name="colorSurface">@color/utechat_surface</item>
        <item name="colorOnSurface">@color/utechat_on_surface</item>
        <item name="colorSurfaceVariant">@color/utechat_surface_variant</item>
        <item name="colorOnSurfaceVariant">@color/utechat_on_surface_variant</item>

        <!-- Error -->
        <item name="colorError">@color/utechat_error</item>
    </style>

    <style name="Theme.UTEChat" parent="Base.Theme.UTEChat" />

    <style name="BottomNavigationItem">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_weight">1</item>
        <item name="android:orientation">vertical</item>
        <item name="android:gravity">center</item>
        <item name="android:minHeight">@dimen/touch_target_min</item>
        <item name="android:paddingTop">@dimen/space_xs</item>
        <item name="android:background">@drawable/bg_bottom_nav_item</item>
        <item name="android:foreground">?attr/selectableItemBackground</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>

    <style name="BottomNavigationIcon">
        <item name="android:layout_width">@dimen/bottom_nav_icon_size</item>
        <item name="android:layout_height">@dimen/bottom_nav_icon_size</item>
        <item name="android:importantForAccessibility">no</item>
        <item name="android:duplicateParentState">true</item>
        <item name="android:tint">@color/bottom_nav_item_color</item>
    </style>

    <style name="BottomNavigationLabel">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">@dimen/space_xs</item>
        <item name="android:textSize">@dimen/text_xs</item>
        <item name="android:textColor">@color/bottom_nav_item_color</item>
        <item name="android:singleLine">true</item>
        <item name="android:importantForAccessibility">no</item>
        <item name="android:duplicateParentState">true</item>
    </style>

    <!-- Keep the launch screen white in both light and dark mode. -->
    <style name="Theme.UTEChat.Splash" parent="Theme.UTEChat">
        <item name="android:windowBackground">@color/white</item>
        <item name="android:statusBarColor">@color/white</item>
        <item name="android:navigationBarColor">@color/white</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:forceDarkAllowed">false</item>
    </style>

    <!-- Action bar themed screens (Login, Register, Chat header) -->
    <style name="Theme.UTEChat.ActionBar" parent="Theme.UTEChat">
        <item name="windowActionBar">true</item>
        <item name="windowNoTitle">false</item>
    </style>

</resources>
