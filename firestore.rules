rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null && request.auth.token.email_verified == true; }
    function contactAllowed(first, second) {
      return !exists(/databases/$(database)/documents/users/$(first)/blocked/$(second))
        && !exists(/databases/$(database)/documents/users/$(second)/blocked/$(first));
    }
    function memberPath(conversationId, uid) {
      return /databases/$(database)/documents/conversations/$(conversationId)/members/$(uid);
    }
    function isMember(conversationId) {
      let parent = get(/databases/$(database)/documents/conversations/$(conversationId));
      let member = get(memberPath(conversationId, request.auth.uid));
      return signedIn()
        && parent.data.get('lifecycle', 'active') == 'active'
        && request.auth.uid in parent.data.participantIds
        && member.data.userId == request.auth.uid;
    }
    function isManager(conversationId) {
      return isMember(conversationId)
        && get(memberPath(conversationId, request.auth.uid)).data.role in ['owner', 'admin'];
    }
    function acceptedFriend(peerUid) {
      let left = request.auth.uid < peerUid ? request.auth.uid : peerUid;
      let right = request.auth.uid < peerUid ? peerUid : request.auth.uid;
      let friendship = /databases/$(database)/documents/friendships/$(left + '_' + right);
      return exists(friendship) && get(friendship).data.status == 'accepted'
        && ((get(friendship).data.fromUid == request.auth.uid && get(friendship).data.toUid == peerUid)
            || (get(friendship).data.toUid == request.auth.uid && get(friendship).data.fromUid == peerUid));
    }

    match /users/{userId} {
      function isOwner() { return signedIn() && request.auth.uid == userId; }
      function validProfile() {
        return request.resource.data.keys().hasOnly(['uid','displayName','email','bio','photoUrl','updatedAt'])
          && request.resource.data.uid == userId
          && request.resource.data.email == request.auth.token.email
          && request.resource.data.displayName is string
          && request.resource.data.displayName.size() > 0
          && request.resource.data.displayName.size() <= 80
          && request.resource.data.bio is string
          && request.resource.data.bio.size() <= 300
          && (request.resource.data.photoUrl == null || request.resource.data.photoUrl is string)
          && request.resource.data.updatedAt is int;
      }
      allow read: if isOwner();
      allow create, update: if isOwner() && validProfile();
      allow delete: if false;

      match /blocked/{peerUid} {
        allow read, delete: if isOwner();
        allow create: if isOwner() && userId != peerUid
          && request.resource.data.keys().hasOnly(['createdAt'])
          && request.resource.data.createdAt == request.time
          && exists(/databases/$(database)/documents/publicProfiles/$(peerUid));
      }

      // FCM registration IDs are private routing data used only by a trusted sender.
      match /deviceTokens/{tokenId} {
        allow read: if false;
        allow create, update: if isOwner()
          && request.resource.data.keys().hasOnly(['token','platform','updatedAt'])
          && request.resource.data.token is string
          && request.resource.data.token.size() >= 20
          && request.resource.data.token.size() <= 4096
          && request.resource.data.platform == 'android'
          && request.resource.data.updatedAt is int;
        allow delete: if isOwner();
      }
    }

    match /userReports/{reporter}/targets/{target} {
      function sourceConversation() {
        return get(/databases/$(database)/documents/conversations/$(request.resource.data.conversationId));
      }
      allow create: if signedIn() && request.auth.uid == reporter && reporter != target
        && request.resource.data.keys().hasOnly(['conversationId', 'reason', 'createdAt'])
        && request.resource.data.conversationId is string
        && request.resource.data.reason in ['spam', 'abuse', 'other']
        && request.resource.data.createdAt == request.time
        && reporter in sourceConversation().data.participantIds
        && target in sourceConversation().data.participantIds
        && (sourceConversation().data.type == 'direct'
          || (sourceConversation().data.type == 'group' && isMember(request.resource.data.conversationId)));
      allow get: if signedIn() && request.auth.uid == reporter;
      allow list, update, delete: if false;
    }

    // Searchable public card; email and biography remain in the owner-only users document.
    match /publicProfiles/{userId} {
      allow get: if signedIn();
      allow list: if signedIn() && request.query.limit <= 20;
      allow create, update: if signedIn() && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(['uid','displayName','searchName','photoUrl','updatedAt'])
        && request.resource.data.uid == userId
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() > 0
        && request.resource.data.displayName.size() <= 80
        && request.resource.data.searchName is string
        && request.resource.data.searchName == request.resource.data.displayName.lower()
        && (request.resource.data.photoUrl == null || request.resource.data.photoUrl is string)
        && request.resource.data.updatedAt is int;
      allow delete: if false;
    }

    // One canonical document per pair prevents duplicate/inverted requests.
    match /friendships/{friendshipId} {
      function participant() {
        return signedIn() && (request.auth.uid == resource.data.fromUid || request.auth.uid == resource.data.toUid);
      }
      function canonicalPair(fromUid, toUid) {
        return fromUid < toUid ? fromUid + '_' + toUid : toUid + '_' + fromUid;
      }
      allow get, list: if participant();
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['fromUid','toUid','status','createdAt','updatedAt'])
        && request.resource.data.fromUid == request.auth.uid
        && request.resource.data.toUid is string
        && request.resource.data.toUid != request.auth.uid
        && contactAllowed(request.auth.uid, request.resource.data.toUid)
        && exists(/databases/$(database)/documents/publicProfiles/$(request.resource.data.toUid))
        && request.resource.data.status == 'pending'
        && request.resource.data.createdAt is int
        && request.resource.data.updatedAt is int
        && friendshipId == canonicalPair(request.resource.data.fromUid, request.resource.data.toUid);
      allow update: if participant()
        && resource.data.status == 'pending'
        && resource.data.toUid == request.auth.uid
        && contactAllowed(resource.data.fromUid, resource.data.toUid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','updatedAt'])
        && request.resource.data.status == 'accepted'
        && request.resource.data.updatedAt is int;
      allow delete: if participant()
        && ((resource.data.status == 'pending'
             && ((resource.data.fromUid == request.auth.uid) || (resource.data.toUid == request.auth.uid)))
            || resource.data.status == 'accepted');
    }

    // A call is one signaling record for one existing direct conversation.
    // Clients may read only calls they participate in; the RTC token service
    // must independently verify this record before minting a short-lived token.
    match /calls/{callId} {
      function callerOrCallee() {
        return signedIn() && (request.auth.uid == resource.data.callerUid
          || request.auth.uid == resource.data.calleeUid);
      }
      function validCallCreate() {
        let conversation = get(/databases/$(database)/documents/conversations/$(request.resource.data.conversationId));
        return signedIn()
          && request.resource.data.keys().hasOnly(['conversationId','callerUid','calleeUid','participants','channelName','mediaType','status','createdAt','updatedAt','expiresAt'])
          && request.resource.data.conversationId is string
          && request.resource.data.callerUid == request.auth.uid
          && request.resource.data.calleeUid is string
          && request.resource.data.calleeUid != request.auth.uid
          && contactAllowed(request.auth.uid, request.resource.data.calleeUid)
          && request.resource.data.participants is list
          && request.resource.data.participants.size() == 2
          && request.resource.data.participants.toSet().size() == 2
          && request.auth.uid in request.resource.data.participants
          && request.resource.data.calleeUid in request.resource.data.participants
          && conversation.data.type == 'direct'
          && conversation.data.participantIds.size() == 2
          && request.auth.uid in conversation.data.participantIds
          && request.resource.data.calleeUid in conversation.data.participantIds
          && request.resource.data.channelName == callId
          && request.resource.data.mediaType in ['audio','video']
          && request.resource.data.status == 'ringing'
          && request.resource.data.createdAt is int
          && request.resource.data.updatedAt == request.resource.data.createdAt
          && request.resource.data.expiresAt == request.resource.data.createdAt + 45000;
      }
      function validCallTransition() {
        let changed = request.resource.data.diff(resource.data).affectedKeys();
        let oldStatus = resource.data.status;
        let nextStatus = request.resource.data.status;
        return changed.hasOnly(['status','updatedAt'])
          && request.resource.data.updatedAt is int
          && request.resource.data.updatedAt >= resource.data.updatedAt
          && ((oldStatus == 'ringing' && request.auth.uid == resource.data.calleeUid
                && nextStatus in ['accepted','rejected','busy','missed']
                && (nextStatus != 'accepted' || (request.time.toMillis() < resource.data.expiresAt
                  && contactAllowed(resource.data.callerUid, resource.data.calleeUid))))
              || (oldStatus == 'ringing' && request.auth.uid == resource.data.callerUid
                && nextStatus in ['ended','failed'])
              || (oldStatus == 'accepted' && callerOrCallee()
                && nextStatus in ['ended','failed']));
      }
      // Inline participant array check lets Firestore prove the incoming-call query.
      allow get, list: if signedIn() && request.auth.uid in resource.data.participants;
      allow create: if validCallCreate();
      allow update: if callerOrCallee() && validCallTransition();
      allow delete: if false;
    }

    match /conversations/{conversationId} {
      function directParticipant(data) {
        return signedIn() && data.type == 'direct' && data.participantIds is list
          && data.participantIds.size() == 2 && request.auth.uid in data.participantIds;
      }
      function conversationCanSend(data) {
        return data.type == 'group' || (data.type == 'direct' && data.participantIds.size() == 2
          && contactAllowed(data.participantIds[0], data.participantIds[1]));
      }
      function groupParticipant(data) {
        return signedIn() && data.type == 'group' && data.participantIds is list
          && request.auth.uid in data.participantIds && isMember(conversationId);
      }
      function validTextSummary() {
        let messagePath = /databases/$(database)/documents/conversations/$(conversationId)/messages/$(request.resource.data.lastMessageId);
        return conversationCanSend(resource.data) && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                 'lastMessage','lastMessageType','lastMessageAt','lastMessageSenderId','lastMessageId','updatedAt'])
          && request.resource.data.lastMessage is string
          && request.resource.data.lastMessage.size() > 0
          && request.resource.data.lastMessage.size() <= 5000
          && request.resource.data.lastMessageType in ['text', 'image', 'poll', 'voice']
          && (resource.data.type == 'direct' || resource.data.type == 'group')
          && (resource.data.type != 'direct' || resource.data.participantIds.size() == 2)
          && (resource.data.type != 'group' || groupParticipant(resource.data))
          && request.resource.data.lastMessageAt is int
          && (!resource.data.keys().hasAny(['lastMessageAt']) || !(resource.data.lastMessageAt is int)
              || request.resource.data.lastMessageAt >= resource.data.lastMessageAt)
          && request.resource.data.lastMessageSenderId == request.auth.uid
          && request.resource.data.lastMessageId is string
          && request.resource.data.updatedAt == request.resource.data.lastMessageAt
          && existsAfter(messagePath)
          && getAfter(messagePath).data.senderId == request.auth.uid
          && ((request.resource.data.lastMessageType == 'text'
                && getAfter(messagePath).data.type == 'text'
                && getAfter(messagePath).data.content == request.resource.data.lastMessage)
              || (request.resource.data.lastMessageType == 'image'
                && request.resource.data.lastMessage == 'image'
                && getAfter(messagePath).data.type == 'image'
                && getAfter(messagePath).data.mediaPath == 'conversations/' + conversationId + '/' + request.auth.uid + '/' + request.resource.data.lastMessageId)
              || (request.resource.data.lastMessageType == 'voice'
                && request.resource.data.lastMessage == 'Tin nhắn thoại'
                && getAfter(messagePath).data.type == 'voice')
              || (request.resource.data.lastMessageType == 'poll'
                && getAfter(messagePath).data.type == 'poll'
                && getAfter(messagePath).data.pollQuestion == request.resource.data.lastMessage))
          && getAfter(messagePath).data.sentAt == request.resource.data.lastMessageAt;
      }
      function validReadCursor() {
        let before = resource.data.get('readStates', {});
        let after = request.resource.data.readStates;
        let cursor = after[request.auth.uid];
        let oldCursor = before.get(request.auth.uid, {'readAt': 0});
        let message = get(/databases/$(database)/documents/conversations/$(conversationId)/messages/$(cursor.messageId));
        return signedIn() && request.auth.uid in resource.data.participantIds
          && (resource.data.type == 'direct' || isMember(conversationId))
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readStates'])
          && after is map && before is map
          && after.diff(before).affectedKeys().hasOnly([request.auth.uid])
          && cursor is map && cursor.keys().hasOnly(['messageId', 'readAt'])
          && cursor.messageId is string && cursor.readAt is int
          && cursor.readAt >= oldCursor.readAt
          && message.data.sentAt == cursor.readAt;
      }
      function validGroupDetailsChange() {
        return resource.data.type == 'group' && isManager(conversationId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'groupName','groupPhotoUrl','updatedAt'])
          && request.resource.data.updatedAt is int
          && request.resource.data.groupName is string
          && request.resource.data.groupName.size() > 0
          && request.resource.data.groupName.size() <= 80;
      }
      function validCommunityUpgrade() {
        return resource.data.type == 'group' && isMember(conversationId)
          && get(memberPath(conversationId, request.auth.uid)).data.role == 'owner'
          && resource.data.get('isCommunity', false) == false
          && resource.data.participantIds.size() >= 5
          && resource.data.participantIds.size() <= 10
          && request.resource.data.isCommunity == true
          && request.resource.data.updatedAt is int
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isCommunity','updatedAt']);
      }
      function validOwnershipTransfer() {
        let target = request.resource.data.ownerUid;
        return resource.data.type == 'group' && isMember(conversationId)
          && get(memberPath(conversationId, request.auth.uid)).data.role == 'owner'
          && target is string && target != request.auth.uid && target in resource.data.participantIds
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['ownerUid','updatedAt'])
          && request.resource.data.updatedAt is int
          && get(memberPath(conversationId, target)).data.role in ['admin','member']
          && getAfter(memberPath(conversationId, request.auth.uid)).data.role == 'admin'
          && getAfter(memberPath(conversationId, target)).data.role == 'owner';
      }
      function initialMemberAt(index) {
        let ids = request.resource.data.participantIds;
        return ids.size() <= index || (getAfter(memberPath(conversationId, ids[index])).data.userId == ids[index]
          && getAfter(memberPath(conversationId, ids[index])).data.role == (index == 0 ? 'owner' : 'member'));
      }
      function validMembershipChange() {
        let oldIds = resource.data.participantIds.toSet();
        let newIds = request.resource.data.participantIds.toSet();
        let uid = request.resource.data.membershipChangeUid;
        let action = request.resource.data.membershipChangeAction;
        let changed = request.resource.data.diff(resource.data).affectedKeys();
        return resource.data.type == 'group' && isManager(conversationId)
          && changed.hasOnly(['participantIds','participantSummaries','updatedAt','membershipChangeAction','membershipChangeUid'])
          && request.resource.data.updatedAt is int && uid is string && action is string
          && request.resource.data.participantIds is list
          && newIds.size() == request.resource.data.participantIds.size()
          && ((action == 'add' && !(uid in oldIds) && uid in newIds
                && newIds.size() <= (resource.data.get('isCommunity', false) == true ? 10 : 5)
                && newIds.difference(oldIds).size() == 1 && oldIds.difference(newIds).size() == 0
                && existsAfter(memberPath(conversationId, uid))
                && getAfter(memberPath(conversationId, uid)).data.role == 'member')
              || (action == 'remove' && uid in oldIds && !(uid in newIds)
                && oldIds.difference(newIds).size() == 1 && newIds.difference(oldIds).size() == 0
                && (!exists(memberPath(conversationId, uid))
                    || (get(memberPath(conversationId, uid)).data.role != 'owner'
                        && (get(memberPath(conversationId, request.auth.uid)).data.role == 'owner'
                            || get(memberPath(conversationId, uid)).data.role == 'member')))
                && !existsAfter(memberPath(conversationId, uid))));
      }
      function validSelfLeave() {
        let oldIds = resource.data.participantIds.toSet();
        let newIds = request.resource.data.participantIds.toSet();
        return resource.data.type == 'group' && isMember(conversationId)
          && request.auth.uid in resource.data.participantIds
          && !(request.auth.uid in request.resource.data.participantIds)
          && newIds.size() == request.resource.data.participantIds.size()
          && request.resource.data.membershipChangeAction == 'remove'
          && request.resource.data.membershipChangeUid == request.auth.uid
          && get(memberPath(conversationId, request.auth.uid)).data.role != 'owner'
          && newIds.difference(oldIds).size() == 0 && oldIds.difference(newIds).size() == 1
          && request.resource.data.updatedAt is int
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['participantIds','participantSummaries','updatedAt','membershipChangeAction','membershipChangeUid'])
          && !existsAfter(memberPath(conversationId, request.auth.uid));
      }
      // Keep this condition inline so Firestore can prove array-contains queries
      // are constrained to documents whose participantIds include the caller.
      allow get, list: if signedIn()
        && request.auth.uid in resource.data.participantIds;
      allow create: if (signedIn() && request.resource.data.type == 'direct'
        && request.resource.data.participantIds is list
        && request.resource.data.participantIds.size() == 2
        && request.resource.data.participantIds.toSet().size() == 2
        && request.auth.uid in request.resource.data.participantIds
        && contactAllowed(request.resource.data.participantIds[0], request.resource.data.participantIds[1])
        && acceptedFriend(request.resource.data.participantIds[0] == request.auth.uid
             ? request.resource.data.participantIds[1] : request.resource.data.participantIds[0])
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.createdAt is int
        && request.resource.data.updatedAt is int
        && request.resource.data.lastMessageAt is int)
        || (signedIn() && request.resource.data.type == 'group'
        && !exists(/databases/$(database)/documents/backendGroupDeletions/$(conversationId))
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.participantIds is list
        && request.resource.data.participantIds.size() >= 3
        && request.resource.data.participantIds.size() <= 5
        && request.resource.data.participantIds.toSet().size() == request.resource.data.participantIds.size()
        && request.resource.data.participantIds[0] == request.auth.uid
        && request.resource.data.get('ownerUid', request.auth.uid) == request.auth.uid
        && request.resource.data.get('isCommunity', false) == false
        && request.resource.data.get('lifecycle', 'active') == 'active'
        && initialMemberAt(0) && initialMemberAt(1) && initialMemberAt(2)
        && initialMemberAt(3) && initialMemberAt(4)
        && request.resource.data.groupName is string
        && request.resource.data.groupName.size() > 0
        && request.resource.data.groupName.size() <= 80
        && existsAfter(memberPath(conversationId, request.auth.uid))
        && getAfter(memberPath(conversationId, request.auth.uid)).data.role == 'owner');
      // Dispatch by the fields being changed before evaluating operation-specific
      // getAfter/optional fields. This also keeps evaluation below the rules limit.
      allow update: if signedIn()
        && ((resource.data.type == 'direct' && directParticipant(resource.data))
            || (resource.data.type == 'group' && isMember(conversationId)))
        && ((request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'lastMessage','lastMessageType','lastMessageAt','lastMessageSenderId','lastMessageId','updatedAt']) && validTextSummary())
            || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readStates']) && validReadCursor())
            || (resource.data.type == 'group'
                && ((request.resource.data.diff(resource.data).affectedKeys().hasAny(['groupName','groupPhotoUrl']) && validGroupDetailsChange())
                    || (request.resource.data.diff(resource.data).affectedKeys().hasAny(['participantIds']) && (validMembershipChange() || validSelfLeave()))
                    || (request.resource.data.diff(resource.data).affectedKeys().hasAny(['isCommunity']) && validCommunityUpgrade())
                    || (request.resource.data.diff(resource.data).affectedKeys().hasAny(['ownerUid']) && validOwnershipTransfer()))));
      // Deletion goes through /api/group-delete: the server checks owner/last
      // member, freezes writes and removes the roster, history and private media.
      allow delete: if false;

      match /members/{memberUid} {
        function parent() { return get(/databases/$(database)/documents/conversations/$(conversationId)); }
        function manager() { return isManager(conversationId); }
        function validTransferredRole() {
          let after = getAfter(/databases/$(database)/documents/conversations/$(conversationId));
          let target = after.data.ownerUid;
          return after.data.diff(parent().data).affectedKeys().hasAny(['ownerUid'])
            && target != request.auth.uid && target in parent().data.participantIds
            && getAfter(memberPath(conversationId, request.auth.uid)).data.role == 'admin'
            && getAfter(memberPath(conversationId, target)).data.role == 'owner'
            && ((memberUid == request.auth.uid && resource.data.role == 'owner' && request.resource.data.role == 'admin')
                || (memberUid == target && resource.data.role in ['admin','member'] && request.resource.data.role == 'owner'));
        }
        function removedFromConversationAfter() {
          let updatedConversation = getAfter(/databases/$(database)/documents/conversations/$(conversationId));
          return updatedConversation.data.membershipChangeAction == 'remove'
            && updatedConversation.data.membershipChangeUid == memberUid
            && !(memberUid in updatedConversation.data.participantIds);
        }
        function canDeleteMember() {
          let callerRole = get(memberPath(conversationId, request.auth.uid)).data.role;
          return (manager()
              && ((callerRole == 'owner' && resource.data.role != 'owner')
                  || (callerRole == 'admin' && resource.data.role == 'member'))
              && (!(memberUid in parent().data.participantIds) || removedFromConversationAfter()))
            || (isMember(conversationId) && request.auth.uid == memberUid && resource.data.role != 'owner'
                && removedFromConversationAfter());
        }
        // A group member may load the member roster as a collection query. Keep
        // individual get restricted to listed members; the list itself is safe
        // because only current conversation members can access this subcollection.
        allow get: if isMember(conversationId) && memberUid in parent().data.participantIds;
        allow list: if isMember(conversationId);
        allow create: if signedIn() && request.resource.data.userId == memberUid
          && request.resource.data.keys().hasOnly(['userId','role','joinedAt','lastReadAt','unreadCount'])
          && request.resource.data.role in ['owner','admin','member']
          && ((memberUid == request.auth.uid && request.resource.data.role == 'owner')
              || (memberUid != request.auth.uid && request.resource.data.role == 'member'))
          && request.resource.data.joinedAt is int
          && request.resource.data.lastReadAt is int
          && request.resource.data.unreadCount is int
          && ((!exists(/databases/$(database)/documents/conversations/$(conversationId))
               && existsAfter(/databases/$(database)/documents/conversations/$(conversationId))
               && getAfter(/databases/$(database)/documents/conversations/$(conversationId)).data.type == 'group'
               && getAfter(/databases/$(database)/documents/conversations/$(conversationId)).data.createdBy == request.auth.uid
               && memberUid in getAfter(/databases/$(database)/documents/conversations/$(conversationId)).data.participantIds
               && (memberUid == request.auth.uid || acceptedFriend(memberUid)))
              || (manager() && request.resource.data.role == 'member'
                  && memberUid in getAfter(/databases/$(database)/documents/conversations/$(conversationId)).data.participantIds
                  && getAfter(/databases/$(database)/documents/conversations/$(conversationId)).data.membershipChangeAction == 'add'
                  && getAfter(/databases/$(database)/documents/conversations/$(conversationId)).data.membershipChangeUid == memberUid
                  && acceptedFriend(memberUid)));
        allow update: if manager()
          && request.resource.data.userId == resource.data.userId
          && request.resource.data.role in ['owner','admin','member']
          && request.resource.data.lastReadAt is int && request.resource.data.unreadCount is int
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role','joinedAt','lastReadAt','unreadCount'])
          && (request.resource.data.role == resource.data.role
              || (get(memberPath(conversationId, request.auth.uid)).data.role == 'owner'
                  && ((memberUid != request.auth.uid && resource.data.role in ['admin','member']
                        && request.resource.data.role in ['admin','member'])
                      || validTransferredRole())))
          && (request.resource.data.joinedAt == resource.data.joinedAt
              || (getAfter(/databases/$(database)/documents/conversations/$(conversationId)).data.membershipChangeAction == 'add'
                  && getAfter(/databases/$(database)/documents/conversations/$(conversationId)).data.membershipChangeUid == memberUid));
        allow delete: if canDeleteMember();
      }

      match /messages/{messageId} {
        function parent() { return get(/databases/$(database)/documents/conversations/$(conversationId)); }
        function isConversationParticipant() {
          return signedIn() && parent().data.participantIds is list
            && request.auth.uid in parent().data.participantIds
            && ((parent().data.type == 'direct' && parent().data.participantIds.size() == 2)
                || (parent().data.type == 'group' && isMember(conversationId)));
        }
        function validReply() {
          let reply = request.resource.data.reply;
          let original = get(/databases/$(database)/documents/conversations/$(conversationId)/messages/$(reply.id));
          return reply is map && reply.keys().hasOnly(['id', 'name', 'text', 'type'])
            && reply.id is string && reply.id != messageId
            && reply.name is string && reply.name == original.data.get('senderName', '')
            && reply.text is string && reply.text == original.data.get('content', '')
            && reply.type == original.data.type
            && reply.type in ['text', 'poll', 'image', 'voice'];
        }
        function validTextMessage() {
          let profile = /databases/$(database)/documents/publicProfiles/$(request.auth.uid);
          return request.resource.data.keys().hasOnly(['senderId','senderName','type','content','sentAt','createdAt','readBy','reply'])
            && request.resource.data.keys().hasAll(['senderId','senderName','type','content','sentAt','createdAt','readBy'])
            && request.resource.data.senderId == request.auth.uid
            && exists(profile) && request.resource.data.senderName == get(profile).data.displayName
            && request.resource.data.type == 'text'
            && request.resource.data.content is string
            && request.resource.data.content.size() > 0
            && request.resource.data.content.size() <= 5000
            && request.resource.data.sentAt is int
            && request.resource.data.createdAt == request.resource.data.sentAt
            && request.resource.data.readBy == [request.auth.uid]
            && (!('reply' in request.resource.data) || validReply());
        }
        function validVoiceMessage() {
          let data = request.resource.data;
          let profile = /databases/$(database)/documents/publicProfiles/$(request.auth.uid);
          let media = get(/databases/$(database)/documents/backendVoice/$(conversationId)/media/$(messageId));
          return data.keys().hasOnly(['senderId','senderName','type','content','sentAt','createdAt','readBy',
              'mediaPath','contentType','fileSize','durationMs'])
            && data.type == 'voice' && data.senderId == request.auth.uid
            && data.senderName == get(profile).data.displayName
            && data.content == 'Tin nhắn thoại'
            && data.sentAt is int && data.createdAt == data.sentAt && data.readBy == [request.auth.uid]
            && data.mediaPath == 'conversations/' + conversationId + '/' + request.auth.uid + '/' + messageId
            && data.contentType == 'audio/mp4'
            && data.fileSize is int && data.fileSize > 0 && data.fileSize <= 524288
            && data.durationMs is int && data.durationMs > 0 && data.durationMs <= 61000
            && media.data.path == data.mediaPath && media.data.size == data.fileSize;
        }
        function validImageMessage() {
          let profile = /databases/$(database)/documents/publicProfiles/$(request.auth.uid);
          return request.resource.data.keys().hasOnly(['senderId','senderName','type','content','sentAt','createdAt','readBy','mediaPath','contentType','fileSize'])
            && request.resource.data.keys().hasAll(['senderId','senderName','type','content','sentAt','createdAt','readBy','mediaPath','contentType','fileSize'])
            && request.resource.data.senderId == request.auth.uid
            && exists(profile) && request.resource.data.senderName == get(profile).data.displayName
            && request.resource.data.type == 'image'
            && request.resource.data.content == ''
            && request.resource.data.mediaPath == 'conversations/' + conversationId + '/' + request.auth.uid + '/' + messageId
            && request.resource.data.contentType in ['image/jpeg','image/png','image/webp']
            && request.resource.data.fileSize is int
            && request.resource.data.fileSize > 0
            && request.resource.data.fileSize <= 8388608
            && request.resource.data.sentAt is int
            && request.resource.data.createdAt == request.resource.data.sentAt
            && request.resource.data.readBy == [request.auth.uid];
        }
        function validPollOption(options, index) {
          return index >= options.size()
            || (options[index] is string && options[index].size() > 0 && options[index].size() <= 80);
        }
        function validPollMessage() {
          let profile = /databases/$(database)/documents/publicProfiles/$(request.auth.uid);
          let options = request.resource.data.pollOptions;
          return request.resource.data.keys().hasOnly(['senderId','senderName','type','content','sentAt','createdAt','readBy','pollQuestion','pollOptions','pollVotes'])
            && request.resource.data.keys().hasAll(['senderId','senderName','type','content','sentAt','createdAt','readBy','pollQuestion','pollOptions','pollVotes'])
            && request.resource.data.senderId == request.auth.uid
            && exists(profile) && request.resource.data.senderName == get(profile).data.displayName
            && request.resource.data.type == 'poll'
            && request.resource.data.pollQuestion is string
            && request.resource.data.pollQuestion.size() > 0
            && request.resource.data.pollQuestion.size() <= 200
            && request.resource.data.content == request.resource.data.pollQuestion
            && options is list && options.size() >= 2 && options.size() <= 6
            && options.toSet().size() == options.size()
            && validPollOption(options, 0) && validPollOption(options, 1)
            && validPollOption(options, 2) && validPollOption(options, 3)
            && validPollOption(options, 4) && validPollOption(options, 5)
            && request.resource.data.pollVotes is map
            && request.resource.data.pollVotes.size() == 0
            && request.resource.data.sentAt is int
            && request.resource.data.createdAt == request.resource.data.sentAt
            && request.resource.data.readBy == [request.auth.uid];
        }
        function validPollVote() {
          let changed = request.resource.data.diff(resource.data).affectedKeys();
          let votes = request.resource.data.pollVotes;
          let oldVotes = resource.data.pollVotes;
          let choice = votes[request.auth.uid];
          return isConversationParticipant()
            && resource.data.type == 'poll'
            && changed.hasOnly(['pollVotes'])
            && votes is map && oldVotes is map
            && votes.diff(oldVotes).affectedKeys().hasOnly([request.auth.uid])
            && request.auth.uid in votes.keys()
            && choice is int && choice >= 0 && choice < resource.data.pollOptions.size();
        }
        allow get, list: if isConversationParticipant();
        allow create: if isConversationParticipant() && conversationCanSend(parent().data)
          && (validTextMessage() || validImageMessage() || validPollMessage() || validVoiceMessage());
        allow update: if (isConversationParticipant() && resource.data.senderId == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([])) || validPollVote();
        allow delete: if false;
      }
    }
  }
}
